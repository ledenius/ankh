  printf 'ankh %s: identity bootstrap for a fresh machine\n\n' "$ANKH_VERSION"
}

usage() {
  cat <<'USAGE'
Usage: ankh [-y] <command> [options]

Commands:
  check [--decrypt]      Report on tools, gpg-agent, keys, the pass store
                         and SSH; changes nothing. --decrypt also decrypts
                         one entry (may ask for the passphrase); the value
                         is discarded, never shown
  key [--existing | --generate | --import <file|dir|->]
                         Choose the gpg key: one in the keyring, a new one
                         (an ed25519 primary that only certifies; ed25519
                         sign and auth and cv25519 encrypt subkeys), or one
                         from a file, a backup directory or a paste. Sets
                         ownertrust; offers a backup after generating
  backup <dir> [--key <fpr>] [--encrypt] [--remove-primary]
                         Write a complete backup into an empty directory, to
                         keep offline: the full key, the subkeys, the public
                         key, revocation, ownertrust, paperkey, SSH keys.
                         Verified by restoring it into a throwaway gpg home.
                         --encrypt seals it with its own passphrase;
                         --remove-primary then leaves only the subkeys here
  pass [--clone <url> | --new [--remote <url>]] [--key <fpr>]
                         Get the pass store: check the one here, clone it,
                         or start a new one encrypted to the key. Proves the
                         key decrypts it (the value is discarded)
  ssh [--generate | --existing <file> | --gpg | --fido2] [--no-passphrase]
                         Get an SSH key: generate one, place an existing
                         one, use the gpg key's authentication subkey through
                         gpg-agent, or a FIDO2 key. Asks each key's name and
                         directory (defaults: its own name, ~/.ssh); backs
                         file keys up into pass as ssh/<name>/key
  init                   check, then key, pass and ssh, then check again
  pull <user@host> [key] [pass] [ssh] [--with-primary] [--key <fpr>]
                         On the new machine: fetch them from the old one over
                         SSH (the password asked once; rsync, or scp without
                         it). Default: all three, the key as subkeys only
  send <user@host> [key] [pass] [ssh] [--with-primary] [--key <fpr>]
                         The same, run on the old machine
                         Both take --remote-ankh <cmd>: how to run ankh on
                         the other machine (default ankh)
  send --paste [key] [ssh] [--qr]
                         Print a block sealed with a one-time passphrase, to
                         paste (or scan) on the new machine; no network needed
  receive [<dir> | <file>]
                         Take what send or send --paste gave: a bundle
                         directory, a file holding the block, or a paste
  bundle <dir> [key] [pass] [ssh] [--with-primary] [--key <fpr>]
                         Write a bundle into an empty directory (what pull
                         runs on the old machine)
  verify <file> [--checkpoint <url|file>]... [--no-default-checkpoints]
         [--as <name>] [--insecure-skip-verify]
                         Check a downloaded ankh against checksum files: the
                         release's on the public mirrors, and any you give.
                         A mismatch stops; an unreachable one only warns;
                         none confirming stops
  version                Print ankh's version
  help                   Show this help

Options:
  -y, --yes              Non-interactive: answers come from the environment
                         (key_source, key_file, key_import, gpg_fpr, gpg_name,
                         gpg_email, gpg_expire, gpg_subkey_expire,
                         pass_source, pass_remote, ssh_source, ssh_file,
                         ssh_name, ssh_dir, ssh_subkey, ssh_no_passphrase).
                         Passphrases are always asked by gpg-agent

Environment:
  GNUPGHOME              gpg home (default ~/.gnupg)
  PASSWORD_STORE_DIR     pass store (default ~/.password-store)
  ANKH_SSH               the ssh program for pull and send (default ssh)
USAGE
}


# --- check: report lines ---------------------------------------------------
# One line per finding: a mark, then the text. FAIL means a required piece is
# missing or broken; warn means it works but something needs attention.

CHECK_FAILS=0
CHECK_WARNS=0

_section() { printf '%s\n' "$1"; }
_ok() { printf '  ok    %s\n' "$1"; }
_info() { printf '  --    %s\n' "$1"; }
_warn() {
  printf '  warn  %s\n' "$1"
  CHECK_WARNS=$((CHECK_WARNS + 1))
}
_fail() {
  printf '  FAIL  %s\n' "$1"
  CHECK_FAILS=$((CHECK_FAILS + 1))
}
_detail() { printf '          %s\n' "$1"; }

_date() {
  # Epoch seconds to YYYY-MM-DD, without GNU/BSD date differences.
  local out
  printf -v out '%(%F)T' "$1"
  printf '%s' "$out"
}

# --- check: tools ----------------------------------------------------------

_tool_version() {
  case "$1" in
  gpg) gpg --version 2>/dev/null | awk 'NR==1{print $3}' ;;
  git) git --version 2>/dev/null | awk '{print $3}' ;;
  pass) pass --version 2>/dev/null | grep -oE 'v[0-9][0-9.]*' | head -1 ;;
  ssh) ssh -V 2>&1 | awk -F'[ ,]' '{print $1}' ;;
  rsync) rsync --version 2>/dev/null | awk 'NR==1{print $3}' ;;
  *) printf '' ;;
  esac
}

_check_tools() {
  _section "tools"
  _ok "bash $BASH_VERSION"
  local t v
  for t in gpg gpgconf gpg-connect-agent git pass ssh ssh-keygen ssh-add scp; do
    if command -v "$t" >/dev/null 2>&1; then
      v="$(_tool_version "$t")"
      _ok "$t${v:+ $v}"
    else
      _fail "$t: not found (required)"
    fi
  done
  local -A why=(
    [rsync]="copying between machines; scp is used without it"
    [paperkey]="a printable copy of the secret key in backups"
    [ykman]="YubiKey touch policy"
    [qrencode]="QR codes for pasted bundles"
    [curl]="fetching checkpoints for ankh verify; wget is used without it"
  )
  for t in rsync paperkey ykman qrencode curl; do
    if command -v "$t" >/dev/null 2>&1; then
      v="$(_tool_version "$t")"
      _ok "$t${v:+ $v}"
    else
      _info "$t: not installed (optional: ${why[$t]})"
    fi
  done
}

# --- check: gpg-agent ------------------------------------------------------

_agent_option() {
  # The configured value of a gpg-agent option, without gpgconf's quoting.
  gpgconf --list-options gpg-agent 2>/dev/null |
    awk -F: -v o="$1" '$1==o{v=$10; sub(/^"/, "", v); print v}'
}

_check_agent() {
  _section "gpg-agent"
  command -v gpg-connect-agent >/dev/null 2>&1 || {
    _fail "gpg-connect-agent not found"
    return 0
  }
  local v
  if v="$(gpg-connect-agent 'getinfo version' /bye 2>/dev/null | awk '/^D /{print $2}')" && [[ -n "$v" ]]; then
    _ok "running, $v ($(gpgconf --list-dirs agent-socket 2>/dev/null))"
  else
    _fail "not reachable: gpg-connect-agent could not start or reach it"
    return 0
  fi

  local pin
  pin="$(_agent_option pinentry-program)"
  if [[ -n "$pin" ]]; then
    if [[ -x "$pin" ]]; then _ok "pinentry $pin"; else _fail "pinentry $pin: not executable"; fi
  elif command -v pinentry >/dev/null 2>&1; then
    _ok "pinentry $(command -v pinentry) (default)"
  else
    _fail "no pinentry: set pinentry-program in gpg-agent.conf or install one"
  fi

  if [[ -t 0 ]]; then
    local here
    here="$(tty)"
    if [[ -z "${GPG_TTY:-}" ]]; then
      _warn "GPG_TTY is not set: a terminal pinentry can't find this terminal"
      _detail "add to your shell config: export GPG_TTY=\$(tty)"
    elif [[ "$GPG_TTY" != "$here" ]]; then
      _warn "GPG_TTY is $GPG_TTY, this terminal is $here"
    else
      _ok "GPG_TTY $GPG_TTY"
    fi
  else
    _info "not on a terminal: GPG_TTY not checked"
  fi
}

# --- check: keys -----------------------------------------------------------
# Parsed from --with-colons. Field 12 holds a key's own capabilities in lower
# case; field 15 is "#" for a stub, a serial number for a key on a card.

declare -a KEY_ENC_IDS=() KEY_AUTH_GRIPS=()

_key_where() {
  case "$1" in
  "#") printf 'not on this machine (stub)' ;;
  "" | "+") printf 'on this machine' ;;
  *) printf 'on card %s' "$1" ;;
  esac
}

_key_uses() {
  local caps="$1" out=() c
  for ((c = 0; c < ${#caps}; c++)); do
    case "${caps:c:1}" in
    c) out+=(certify) ;;
    s) out+=(sign) ;;
    e) out+=(encrypt) ;;
    a) out+=(auth) ;;
    esac
  done
  local IFS=,
  printf '%s' "${out[*]}"
}

_key_expiry() {
  # Prints the expiry, and returns 1 when it is within 30 days.
  local exp="$1" now
  [[ -n "$exp" ]] || {
    printf 'no expiry'
    return 0
  }
  printf -v now '%(%s)T' -1
  printf 'expires %s' "$(_date "$exp")"
  ((exp - now > 30 * 86400))
}

_check_keys() {
  _section "keys"
  command -v gpg >/dev/null 2>&1 || {
    _fail "gpg not found"
    return 0
  }
  local -a lines
  mapfile -t lines < <(gpg --with-colons --fixed-list-mode --with-keygrip --list-secret-keys 2>/dev/null)
  if [[ ${#lines[@]} -eq 0 ]]; then
    _fail "no secret keys in $ANKH_GNUPGHOME"
    return 0
  fi

  local line kind="" uid="" fpr="" n=0
  local -a f
  local -a sub_lines=()
  local primary=""

  _flush_key() {
    [[ -n "$primary" ]] || return 0
    IFS=: read -r -a f <<<"$primary"
    local validity="${f[1]}" exp="${f[6]}" caps="${f[11]}" token="${f[14]:-}"
    if [[ "$validity" == r ]]; then
      _info "$fpr $uid: revoked"
      primary=""
      return 0
    fi
    if [[ "$validity" == e ]]; then
      _warn "$fpr $uid: expired"
      primary=""
      return 0
    fi
    _ok "$fpr $uid"
    local e
    if e="$(_key_expiry "$exp")"; then :; else _warn "primary key $e"; fi
    _detail "primary  $(_key_uses "$caps")  $(_key_where "$token")  $e"
    if [[ "$token" != "#" && "$caps" == *c* ]]; then
      _detail "the primary key is on this machine: once backed up, it can be removed"
    fi
    local s has_enc=0 has_auth=0
    for s in "${sub_lines[@]}"; do
      IFS=: read -r -a f <<<"$s"
      local sv="${f[1]}" sid="${f[4]}" sexp="${f[6]}" scaps="${f[11]}" stok="${f[14]:-}" sgrip="${f[20]:-}"
      [[ "$sv" == r || "$sv" == e ]] && continue
      if e="$(_key_expiry "$sexp")"; then :; else _warn "subkey $sid $e"; fi
      _detail "$(printf '%-8s' "$(_key_uses "$scaps")") $sid  $(_key_where "$stok")  $e"
      if [[ "$scaps" == *e* && "$stok" != "#" ]]; then
        has_enc=1
        KEY_ENC_IDS+=("$sid")
      fi
      if [[ "$scaps" == *a* && "$stok" != "#" ]]; then
        has_auth=1
        KEY_AUTH_GRIPS+=("$sgrip")
      fi
    done
    [[ $has_enc -eq 1 ]] || _warn "no usable encryption subkey: this key can't decrypt a pass store"
    [[ $has_auth -eq 1 ]] || _detail "no authentication subkey: SSH through gpg-agent isn't possible with it"
    n=$((n + 1))
    primary=""
  }

  for line in "${lines[@]}"; do
    kind="${line%%:*}"
    case "$kind" in
    sec)
      _flush_key
      primary="$line"
      uid=""
      fpr=""
      sub_lines=()
      kind=sec
      ;;
    fpr)
      [[ -z "$fpr" ]] && fpr="$(cut -d: -f10 <<<"$line")"
      ;;
    grp)
      # The keygrip belongs to the record before it; append it as field 21.
      if [[ ${#sub_lines[@]} -gt 0 ]]; then
        local last=$((${#sub_lines[@]} - 1))
        IFS=: read -r -a f <<<"${sub_lines[$last]}"
        if [[ -z "${f[20]:-}" ]]; then
          while [[ ${#f[@]} -lt 20 ]]; do f+=(""); done
          f[20]="$(cut -d: -f10 <<<"$line")"
          sub_lines[last]="$(
            IFS=:
            printf '%s' "${f[*]}"
          )"
        fi
      fi
      ;;
    uid)
      IFS=: read -r -a f <<<"$line"
      [[ -z "$uid" && "${f[1]}" != r ]] && uid="${f[9]}"
      ;;
    ssb)
      sub_lines+=("$line")
      ;;
    esac
  done
  _flush_key
  unset -f _flush_key

  if command -v timeout >/dev/null 2>&1; then
    local serial
    serial="$(timeout 10 gpg --with-colons --card-status 2>/dev/null | awk -F: '/^serial:/{print $2}')" || true
    if [[ -n "$serial" ]]; then _ok "card $serial present"; else _info "no card"; fi
  fi
}

# --- check: the pass store -------------------------------------------------

_check_pass() {
  local decrypt="$1"
  _section "pass"
  if [[ ! -d "$ANKH_STORE" ]]; then
    _fail "no store at $ANKH_STORE"
    return 0
  fi
  if [[ ! -f "$ANKH_STORE/.gpg-id" ]]; then
    _fail "$ANKH_STORE has no .gpg-id: not a pass store"
    return 0
  fi
  local count
  count="$(find "$ANKH_STORE" -path "$ANKH_STORE/.git" -prune -o -type f -name '*.gpg' -print | wc -l)"
  _ok "$ANKH_STORE, $((count)) entries"
  if git -C "$ANKH_STORE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local remote
    remote="$(git -C "$ANKH_STORE" remote get-url origin 2>/dev/null || true)"
    if [[ -n "$remote" ]]; then _ok "git, remote $remote"; else _info "git, no remote"; fi
  else
    _info "not a git repository"
  fi

  local sample
  sample="$(find "$ANKH_STORE" -path "$ANKH_STORE/.git" -prune -o -type f -name '*.gpg' -print -quit)"
  [[ -n "$sample" ]] || {
    _info "no entries to test against"
    return 0
  }
  # --list-only skips the decryption itself: only the recipients are read.
  local -a to
  mapfile -t to < <(gpg --batch --list-only --status-fd 1 --decrypt "$sample" 2>/dev/null |
    awk '$1=="[GNUPG:]" && $2=="ENC_TO"{print toupper($3)}')
  local id hit=""
  for id in "${to[@]}"; do
    local mine
    for mine in "${KEY_ENC_IDS[@]}"; do
      [[ "${mine^^}" == "$id" ]] && hit="$id"
    done
  done
  if [[ -n "$hit" ]]; then
    _ok "entries are encrypted to subkey $hit, which this machine has"
  else
    _fail "entries are encrypted to ${to[*]:-unknown keys}: none of them is usable here"
    return 0
  fi

  if [[ "$decrypt" -eq 1 ]]; then
    if gpg --quiet --decrypt "$sample" >/dev/null 2>&1; then
      _ok "test decrypt succeeded"
    else
      _fail "test decrypt failed"
    fi
  else
    _info "test decrypt skipped (ankh check --decrypt)"
  fi
}

# --- check: SSH ------------------------------------------------------------

_check_ssh() {
  _section "ssh"
  local -a pubs=()
  local p dir
  for dir in "${ANKH_SSH_DIRS[@]}"; do
    for p in "$dir"/*.pub; do
      [[ -f "$p" ]] && pubs+=("$p")
    done
  done
  if [[ ${#pubs[@]} -gt 0 ]]; then
    _ok "${#pubs[@]} key(s) on disk"
  elif [[ ${#KEY_AUTH_GRIPS[@]} -gt 0 ]]; then
    _info "no key files: only gpg authentication subkeys"
  else
    _fail "no SSH key: none on disk and no gpg authentication subkey"
  fi

  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    _warn "no agent: SSH_AUTH_SOCK is not set"
    return 0
  fi
  if [[ ! -S "$SSH_AUTH_SOCK" ]]; then
    _warn "no agent: $SSH_AUTH_SOCK is not a socket"
    return 0
  fi

  local which="another agent"
  local gpg_ssh
  gpg_ssh="$(gpgconf --list-dirs agent-ssh-socket 2>/dev/null || true)"
  if [[ -n "$gpg_ssh" && "$SSH_AUTH_SOCK" -ef "$gpg_ssh" ]]; then
    which="gpg-agent"
  elif [[ "$SSH_AUTH_SOCK" == *keyring* ]]; then
    which="GNOME Keyring"
  elif [[ "$SSH_AUTH_SOCK" == *com.apple.launchd* ]]; then
    which="macOS's agent"
  elif [[ "$SSH_AUTH_SOCK" == */.ssh/agent/s.*.sshd.* ]]; then
    # OpenSSH 10.1+ keeps agent sockets in ~/.ssh/agent; sshd's are forwarded.
    which="a forwarded agent"
  elif [[ "$SSH_AUTH_SOCK" == */.ssh/agent/s.* || "$SSH_AUTH_SOCK" == *agent.* || "$SSH_AUTH_SOCK" == *ssh-agent* ]]; then
    which="ssh-agent"
  fi

  local listed rc=0
  listed="$(ssh-add -l 2>/dev/null)" || rc=$?
  case "$rc" in
  0) _ok "$which at $SSH_AUTH_SOCK, $(wc -l <<<"$listed") key(s) loaded" ;;
  1)
    _ok "$which at $SSH_AUTH_SOCK, no keys loaded"
    listed=""
    ;;
  *)
    _warn "$SSH_AUTH_SOCK doesn't answer (ssh-add -l exited $rc)"
    return 0
    ;;
  esac

  local fp name
  for p in "${pubs[@]}"; do
    fp="$(ssh-keygen -lf "$p" 2>/dev/null | awk '{print $2}')"
    name="${p#"$HOME"/}"
    if [[ -n "$fp" ]] && grep -qF " $fp " <<<"$listed"; then
      _detail "loaded      ~/$name"
    else
      _detail "not loaded  ~/$name"
    fi
  done

  local enabled
  enabled="$(_agent_option enable-ssh-support)"
  if [[ "$which" == "gpg-agent" ]]; then
    local grip control="$ANKH_GNUPGHOME/sshcontrol"
    for grip in "${KEY_AUTH_GRIPS[@]}"; do
      if [[ -f "$control" ]] && grep -qE "^[[:space:]]*$grip([[:space:]]|$)" "$control"; then
        _detail "offered     authentication subkey $grip"
      else
        _detail "not offered authentication subkey $grip (not in sshcontrol)"
      fi
    done
  elif [[ -n "$enabled" ]]; then
    _info "gpg-agent has SSH support on, but SSH_AUTH_SOCK points to $which"
  fi
}

cmd_check() {
  local decrypt=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --decrypt) decrypt=1 ;;
    *)
      echo "ankh check: unknown option '$1'" >&2
      exit 1
      ;;
    esac
    shift
  done
  # init runs check twice: start each from nothing.
  CHECK_FAILS=0
  CHECK_WARNS=0
  KEY_ENC_IDS=()
  KEY_AUTH_GRIPS=()
  _check_tools
  _check_agent
  _check_keys
  _check_pass "$decrypt"
  _check_ssh
  printf 'check: %d failed, %d warnings\n' "$CHECK_FAILS" "$CHECK_WARNS"
  [[ $CHECK_FAILS -eq 0 ]]
}

# --- shared helpers --------------------------------------------------------

ANKH_YES=0
KEY_FPR=""
SSH_PATH=""
declare -a ANKH_TMP=()

_cleanup() {
  [[ ${#ANKH_REMOTE_TMP[@]} -gt 0 ]] && _remote_cleanup
  local d
  for d in "${ANKH_TMP[@]}"; do
    [[ -d "$d" ]] || continue
    local h
    for h in "$d"/*/; do
      [[ -d "$h" ]] && GNUPGHOME="$h" gpgconf --kill all >/dev/null 2>&1
    done
    rm -rf "$d"
  done
  return 0
}
trap _cleanup EXIT

_say() { printf 'ankh: %s\n' "$*" >&2; }
_die() {
  printf 'ankh: %s\n' "$*" >&2
  exit 1
}

_tmpdir() {
  # A private scratch directory, on tmpfs where there is one; removed at exit.
  # Its locals are prefixed so they never shadow the caller's variable.
  local _tmp_var="$1" _tmp_base="${XDG_RUNTIME_DIR:-}" _tmp_dir
  [[ -n "$_tmp_base" && -d "$_tmp_base" && -w "$_tmp_base" ]] || _tmp_base="/tmp"
  _tmp_dir="$(mktemp -d "$_tmp_base/ankh.XXXXXX")"
  chmod 700 "$_tmp_dir"
  ANKH_TMP+=("$_tmp_dir")
  printf -v "$_tmp_var" '%s' "$_tmp_dir"
}

_temp_gnupghome() {
  # A throwaway gpg home that uses the same pinentry as the real one.
  local _tgh_var="$1" _tgh_tmp _tgh_home
  _tmpdir _tgh_tmp
  _tgh_home="$_tgh_tmp/gnupg"
  mkdir -m 700 "$_tgh_home"
  if [[ -f "$ANKH_GNUPGHOME/gpg-agent.conf" ]]; then
    grep -E '^[[:space:]]*pinentry-program[[:space:]]' "$ANKH_GNUPGHOME/gpg-agent.conf" >"$_tgh_home/gpg-agent.conf" || true
  fi
  printf -v "$_tgh_var" '%s' "$_tgh_home"
}

prompt() {
  # prompt <var> <label> [default]: with -y, the variable's value from the
  # environment, else the default.
  local var="$1" label="$2" default="${3:-}"
  if [[ $ANKH_YES -eq 1 ]]; then
    local val="${!var:-$default}"
    [[ -n "$val" ]] || _die "\$$var is required with -y"
    printf -v "$var" '%s' "$val"
    return 0
  fi
  local input
  if [[ -n "$default" ]]; then
    IFS= read -rp "$label [$default]: " input </dev/tty
    printf -v "$var" '%s' "${input:-$default}"
  else
    IFS= read -rp "$label: " input </dev/tty
    [[ -n "$input" ]] || _die "$label is required"
    printf -v "$var" '%s' "$input"
  fi
}

_confirm() {
  # _confirm <question>: yes only when typed; with -y, always no.
  [[ $ANKH_YES -eq 1 ]] && return 1
  local ans
  IFS= read -rp "$1 [y/N] " ans </dev/tty
  [[ "$ans" == y || "$ans" == Y || "$ans" == yes ]]
}

# --- keys --------------------------------------------------------------------

_secret_keys() {
  # One line per secret key: fingerprint, tab, first valid user ID.
  gpg --with-colons --fixed-list-mode --list-secret-keys 2>/dev/null | awk -F: '
    /^sec/ { want_fpr = 1; uid_done = 0; next }
    /^fpr/ && want_fpr { fpr = $10; want_fpr = 0; next }
    /^uid/ && !uid_done && $2 != "r" { print fpr "\t" $10; uid_done = 1 }
  '
}

_primary_field() {
  # _primary_field <fpr> <n>: field n of the key's sec record.
  gpg --with-colons --fixed-list-mode --list-secret-keys "$1" 2>/dev/null |
    awk -F: -v n="$2" '/^sec/{print $n; exit}'
}

_primary_grip() {
  gpg --with-colons --fixed-list-mode --with-keygrip --list-secret-keys "$1" 2>/dev/null |
    awk -F: '/^sec/{s=1; next} /^grp/ && s{print $10; exit}'
}

_primary_here() {
  # True when the primary key's secret is on this machine, not a stub or card.
  local tok
  tok="$(_primary_field "$1" 15)"
  [[ -z "$tok" || "$tok" == "+" ]]
}

_key_trust() {
  printf '%s:6:\n' "$1" | gpg --import-ownertrust 2>/dev/null
}

_pick_key() {
  # _pick_key <var>: one of the keyring's secret keys; with -y, $gpg_fpr or
  # the only key there is.
  local _pk_var="$1"
  local -a lines
  mapfile -t lines < <(_secret_keys)
  [[ ${#lines[@]} -gt 0 ]] || _die "no secret keys in $ANKH_GNUPGHOME"
  local chosen=""
  if [[ -n "${gpg_fpr:-}" ]]; then
    chosen="$gpg_fpr"
  elif [[ ${#lines[@]} -eq 1 ]]; then
    chosen="${lines[0]%%$'\t'*}"
  elif [[ $ANKH_YES -eq 1 ]]; then
    _die "several secret keys: set \$gpg_fpr to choose one"
  else
    local i
    for ((i = 0; i < ${#lines[@]}; i++)); do
      printf '  %d) %s  %s\n' "$((i + 1))" "${lines[$i]%%$'\t'*}" "${lines[$i]#*$'\t'}" >&2
    done
    local choice
    IFS= read -rp "Key [1-${#lines[@]}]: " choice </dev/tty
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#lines[@]})); then
      _die "no such key"
    fi
    chosen="${lines[$((choice - 1))]%%$'\t'*}"
  fi
  gpg --list-secret-keys "$chosen" >/dev/null 2>&1 || _die "no secret key $chosen"
  # Normalise to the full fingerprint.
  chosen="$(gpg --with-colons --fixed-list-mode --list-secret-keys "$chosen" | awk -F: '/^fpr/{print $10; exit}')"
  printf -v "$_pk_var" '%s' "$chosen"
}

_key_generate() {
  # Sets KEY_FPR to the new key's fingerprint. gpg-agent's pinentry asks for the
  # passphrase: ankh never sees it.
  # Answers with -y come from the environment (see usage).
  local gpg_name="${gpg_name:-}" gpg_email="${gpg_email:-}"
  local gpg_expire="${gpg_expire:-}" gpg_subkey_expire="${gpg_subkey_expire:-}"
  local gecos
  gecos="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f5 | cut -d, -f1)" || gecos=""
  prompt gpg_name "Name" "$gecos"
  prompt gpg_email "Email" ""
  prompt gpg_expire "Primary key expiry (0 = never, e.g. 5y)" "5y"
  prompt gpg_subkey_expire "Subkey expiry (0 = never, e.g. 2y)" "2y"
  local uid="$gpg_name <$gpg_email>"
  if gpg --list-secret-keys "=$uid" >/dev/null 2>&1; then
    _die "a secret key for $uid exists already"
  fi
  _say "generating: an ed25519 primary key that only certifies; gpg-agent asks for its passphrase"
  gpg --batch --quiet --quick-generate-key "$uid" ed25519 cert "$gpg_expire"
  local fpr
  fpr="$(gpg --with-colons --fixed-list-mode --list-secret-keys "=$uid" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')"
  [[ -n "$fpr" ]] || _die "key generation failed"
  KEY_FPR="$fpr"
  _say "adding subkeys: ed25519 sign, ed25519 auth, cv25519 encrypt"
  local use
  for use in sign auth; do
    gpg --batch --quiet --quick-add-key "$fpr" ed25519 "$use" "$gpg_subkey_expire"
  done
  gpg --batch --quiet --quick-add-key "$fpr" cv25519 encr "$gpg_subkey_expire"
}

_unpack_backup() {
  # _unpack_backup <archive> <var>: decrypts an encrypted backup into a
  # private scratch directory and names it.
  local _ub_archive="$1" _ub_var="$2" _ub_tmp
  _tmpdir _ub_tmp
  _say "decrypting $_ub_archive (its own passphrase)"
  gpg --quiet --no-symkey-cache --decrypt "$_ub_archive" | tar -x -C "$_ub_tmp" ||
    _die "could not decrypt $_ub_archive"
  printf -v "$_ub_var" '%s' "$_ub_tmp"
}

_key_import() {
  # _key_import <file|dir|->: sets KEY_FPR to the imported key's fingerprint.
  local src="$1" file=""
  if [[ "$src" == "-" ]]; then
    local t
    _tmpdir t
    file="$t/pasted.asc"
    _say "paste the armored key, then Ctrl+D:"
    cat </dev/tty >"$file"
  elif [[ -d "$src" ]]; then
    if [[ -f "$src/ankh-backup.tar.gpg" ]]; then
      _unpack_backup "$src/ankh-backup.tar.gpg" src
    fi
    local have_full=0 have_sub=0
    [[ -f "$src/secret.asc" ]] && have_full=1
    [[ -f "$src/subkeys.asc" ]] && have_sub=1
    [[ $have_full -eq 1 || $have_sub -eq 1 ]] || _die "$src holds no secret.asc or subkeys.asc"
    local what="${key_import:-}"
    if [[ -z "$what" ]]; then
      if [[ $have_full -eq 1 && $have_sub -eq 1 ]]; then
        if [[ $ANKH_YES -eq 1 ]]; then
          what=subkeys
        else
          local ans
          IFS= read -rp "Import [s]ubkeys only (a daily machine) or the [f]ull key with its primary? [s] " ans </dev/tty
          case "${ans:-s}" in
          s | subkeys) what=subkeys ;;
          f | full) what=full ;;
          *) _die "invalid choice" ;;
          esac
        fi
      elif [[ $have_sub -eq 1 ]]; then
        what=subkeys
      else
        what=full
      fi
    fi
    case "$what" in
    subkeys) file="$src/subkeys.asc" ;;
    full) file="$src/secret.asc" ;;
    *) _die "\$key_import must be subkeys or full" ;;
    esac
    [[ -f "$file" ]] || _die "$file is missing"
  elif [[ -f "$src" ]]; then
    if [[ "$src" == *.tar.gpg ]]; then
      local u
      _unpack_backup "$src" u
      _key_import "$u"
      return 0
    fi
    file="$src"
  else
    _die "$src: no such file or directory"
  fi

  # The fingerprint comes from the file itself: the keyring may hold others.
  local -a fprs
  mapfile -t fprs < <(gpg --with-colons --import-options show-only --import "$file" 2>/dev/null |
    awk -F: '/^sec/{s=1; next} /^fpr/ && s{print $10; s=0}')
  [[ ${#fprs[@]} -eq 1 ]] || _die "$file must hold exactly one secret key (found ${#fprs[@]})"
  _say "importing ${fprs[0]}; gpg-agent may ask for its passphrase"
  gpg --batch --quiet --import "$file" || _die "import failed"
  KEY_FPR="${fprs[0]}"
}

cmd_key() {
  local source="${key_source:-}" path="${key_file:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --generate) source=generate ;;
    --existing) source=existing ;;
    --import)
      source=import
      path="${2:-}"
      [[ -n "$path" ]] || _die "--import needs a file, a backup directory or -"
      shift
      ;;
    *) _die "key: unknown option '$1'" ;;
    esac
    shift
  done

  if [[ -z "$source" ]]; then
    if [[ $ANKH_YES -eq 1 ]]; then
      _die "set \$key_source (existing, generate or import) with -y"
    fi
    local -a lines
    mapfile -t lines < <(_secret_keys)
    local i
    for ((i = 0; i < ${#lines[@]}; i++)); do
      printf '  %d) %s  %s\n' "$((i + 1))" "${lines[$i]%%$'\t'*}" "${lines[$i]#*$'\t'}" >&2
    done
    printf '  g) generate a new key\n  i) import from a file, a backup directory or a paste\n' >&2
    local choice
    IFS= read -rp "Key: " choice </dev/tty
    case "$choice" in
    g) source=generate ;;
    i)
      source=import
      prompt path "File or backup directory (- to paste)" ""
      ;;
    *)
      if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#lines[@]})); then
        _die "invalid choice"
      fi
      gpg_fpr="${lines[$((choice - 1))]%%$'\t'*}"
      source=existing
      ;;
    esac
  fi

  local fpr
  case "$source" in
  existing) _pick_key fpr ;;
  generate)
    _key_generate
    fpr="$KEY_FPR"
    ;;
  import)
    [[ -n "$path" ]] || _die "set \$key_file with key_source=import"
    _key_import "$path"
    fpr="$KEY_FPR"
    ;;
  *) _die "unknown key source '$source'" ;;
  esac
  _key_trust "$fpr"
  _say "using $fpr (ownertrust ultimate)"

  if [[ "$source" == generate ]]; then
    _say "back it up before anything else: ankh backup <dir>"
    local dir=""
    if [[ $ANKH_YES -eq 0 ]]; then
      IFS= read -rp "Backup directory now (empty to skip): " dir </dev/tty
    fi
    [[ -n "$dir" ]] && gpg_fpr="$fpr" cmd_backup "$dir" --key "$fpr"
  fi
  KEY_FPR="$fpr"
  printf 'key %s\n' "$fpr"
}

# --- backup ----------------------------------------------------------------

_backup_ssh() {
  # Copies every SSH key pair (a private key next to its .pub) into <dir>/ssh,
  # keeping ~/.ssh's layout. Prints how many.
  local dest="$1" n=0 dir pub priv rel
  for dir in "${ANKH_SSH_DIRS[@]}"; do
    for pub in "$dir"/*.pub; do
      [[ -f "$pub" ]] || continue
      priv="${pub%.pub}"
      [[ -f "$priv" ]] || continue
      rel="${dir#"$HOME"/.ssh}"
      mkdir -p "$dest/ssh$rel"
      chmod 700 "$dest/ssh" "$dest/ssh$rel"
      cp -p "$priv" "$pub" "$dest/ssh$rel/"
      n=$((n + 1))
    done
  done
  printf '%s' "$n"
}

_backup_readme() {
  local dir="$1" fpr="$2" uid="$3" full="$4" when
  printf -v when '%(%F)T' -1
  {
    echo "ankh backup of $uid"
    echo "fingerprint: $fpr"
    echo "written: $when by ankh $ANKH_VERSION"
    echo ""
    echo "Keep this offline: a USB stick in a drawer, not a synced folder."
    echo ""
    echo "Files:"
    [[ "$full" -eq 1 ]] && echo "  secret.asc      the full secret key: primary and all subkeys"
    echo "  subkeys.asc     the subkeys only, for daily machines"
    echo "  public.asc      the public key"
    [[ -f "$dir/revocation.asc" ]] && echo "  revocation.asc  the revocation certificate"
    echo "  ownertrust.txt  trust settings"
    [[ -f "$dir/paperkey.txt" ]] && echo "  paperkey.txt    the secret part of the key, for printing"
    [[ -d "$dir/ssh" ]] && echo "  ssh/            SSH key pairs, laid out as in ~/.ssh"
    echo ""
    echo "Restore:"
    echo "  ankh key --import <this directory>"
    echo "or by hand:"
    echo "  gpg --import subkeys.asc       (or secret.asc for the full key)"
    echo "  gpg --import-ownertrust ownertrust.txt"
    echo ""
    echo "The secret keys are protected by the key's passphrase."
  } >"$dir/README.txt"
}

_backup_verify() {
  # _backup_verify <file> <fpr> <full>: imports into a throwaway home, then
  # signs and decrypts a test message. Keys held on a card can't be tested.
  local file="$1" fpr="$2" full="$3" h
  _temp_gnupghome h
  local g=(env GNUPGHOME="$h" gpg --batch --quiet)
  "${g[@]}" --import "$file" 2>/dev/null || return 1
  "${g[@]}" --list-secret-keys "$fpr" >/dev/null 2>&1 || return 1
  local tok
  tok="$(GNUPGHOME="$h" gpg --with-colons --fixed-list-mode --list-secret-keys "$fpr" | awk -F: '/^sec/{print $15; exit}')"
  if [[ "$full" -eq 1 ]]; then
    [[ -z "$tok" || "$tok" == "+" ]] || return 1
  else
    [[ "$tok" == "#" ]] || return 1
  fi
  local msg="ankh backup check" out
  out="$(printf '%s' "$msg" | "${g[@]}" --local-user "$fpr" --sign 2>/dev/null |
    "${g[@]}" --decrypt 2>/dev/null)" || return 1
  [[ "$out" == "$msg" ]] || return 1
  out="$(printf '%s' "$msg" | "${g[@]}" --trust-model always --recipient "$fpr" --encrypt 2>/dev/null |
    "${g[@]}" --decrypt 2>/dev/null)" || return 1
  [[ "$out" == "$msg" ]]
}

cmd_backup() {
  local dir="" encrypt=0 remove=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --key)
      gpg_fpr="${2:-}"
      [[ -n "$gpg_fpr" ]] || _die "--key needs a fingerprint"
      shift
      ;;
    --encrypt) encrypt=1 ;;
    --remove-primary) remove=1 ;;
    -*) _die "backup: unknown option '$1'" ;;
    *)
      [[ -z "$dir" ]] || _die "backup: one directory only"
      dir="$1"
      ;;
    esac
    shift
  done
  [[ -n "$dir" ]] || _die "usage: ankh backup <dir> [--key <fpr>] [--encrypt] [--remove-primary]"

  local fpr
  _pick_key fpr
  local uid
  uid="$(_secret_keys | awk -F'\t' -v f="$fpr" '$1==f{print $2; exit}')"

  if [[ -e "$dir" ]]; then
    [[ -d "$dir" ]] || _die "$dir exists and is not a directory"
    [[ -z "$(ls -A "$dir")" ]] || _die "$dir is not empty"
  fi
  local parent
  parent="$(dirname "$dir")"
  [[ -d "$parent" ]] || _die "$parent does not exist"
  if git -C "$parent" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    _die "$dir is inside a git work tree: a backup must not be synced anywhere"
  fi

  # With --encrypt, nothing readable may reach the target: flash and SSDs
  # remap writes, so files deleted there can still be recovered. The backup
  # is built and checked in a private scratch directory, in memory where
  # possible, and only the sealed archive is written to the target.
  local work
  if [[ $encrypt -eq 1 ]]; then
    _tmpdir work
    local fs
    fs="$(stat -f -c %T "$work" 2>/dev/null || true)"
    if [[ "$fs" != tmpfs && "$fs" != ramfs ]]; then
      _say "warning: no tmpfs found; the unencrypted backup is staged on disk in $work while it's built"
    fi
    work="$work/backup"
    mkdir "$work"
  else
    mkdir -p "$dir"
    work="$dir"
  fi
  chmod 700 "$work"
  local old_umask
  old_umask="$(umask)"
  umask 077

  local full=0
  if _primary_here "$fpr"; then
    full=1
  else
    _say "the primary key isn't on this machine: the backup holds the subkeys only"
  fi

  _say "exporting $fpr; gpg-agent may ask for the passphrase"
  gpg --armor --export "$fpr" >"$work/public.asc"
  if [[ $full -eq 1 ]]; then
    gpg --armor --export-secret-keys "$fpr" >"$work/secret.asc" || _die "export failed"
  fi
  gpg --armor --export-secret-subkeys "$fpr" >"$work/subkeys.asc" || _die "export failed"
  gpg --export-ownertrust 2>/dev/null | grep "^$fpr:" >"$work/ownertrust.txt" || printf '%s:6:\n' "$fpr" >"$work/ownertrust.txt"
  if [[ -f "$ANKH_GNUPGHOME/openpgp-revocs.d/$fpr.rev" ]]; then
    cp "$ANKH_GNUPGHOME/openpgp-revocs.d/$fpr.rev" "$work/revocation.asc"
  else
    _say "warning: no revocation certificate in $ANKH_GNUPGHOME/openpgp-revocs.d"
  fi
  if [[ $full -eq 1 ]] && command -v paperkey >/dev/null 2>&1; then
    gpg --export-secret-keys "$fpr" | paperkey --output "$work/paperkey.txt"
  fi
  local n_ssh
  n_ssh="$(_backup_ssh "$work")"
  _backup_readme "$work" "$fpr" "$uid" "$full"

  _say "verifying: importing into a throwaway gpg home, then signing and decrypting"
  local verified=1
  if [[ $full -eq 1 ]]; then
    if _backup_verify "$work/secret.asc" "$fpr" 1; then
      _say "ok: secret.asc restores the full key, and it signs and decrypts"
    else
      _say "FAILED: secret.asc did not restore a working key"
      verified=0
    fi
  fi
  if _backup_verify "$work/subkeys.asc" "$fpr" 0; then
    _say "ok: subkeys.asc restores the subkeys, and they sign and decrypt"
  else
    _say "FAILED: subkeys.asc did not restore working subkeys (keys on a card can't be tested here)"
    verified=0
  fi
  if [[ $verified -ne 1 ]]; then
    [[ $encrypt -eq 1 ]] && _die "the backup is NOT good; nothing was written to $dir"
    _die "the backup in $dir is NOT good"
  fi
  _say "$n_ssh SSH key pair(s) copied"

  if [[ $encrypt -eq 1 ]]; then
    _say "sealing the backup with its own passphrase (asked twice, not cached)"
    local sealed="${work%/backup}/ankh-backup.tar.gpg"
    tar -C "$work" -cf - . | gpg --quiet --no-symkey-cache --symmetric --output "$sealed" ||
      _die "sealing failed; nothing was written to $dir"
    _say "checking the archive opens (the passphrase once more)"
    gpg --quiet --no-symkey-cache --decrypt "$sealed" 2>/dev/null | tar -t >/dev/null ||
      _die "the archive didn't open; nothing was written to $dir"
    mkdir -p "$dir"
    chmod 700 "$dir"
    cp "$sealed" "$dir/ankh-backup.tar.gpg"
    {
      echo "ankh backup of $uid, encrypted"
      echo "fingerprint: $fpr"
      echo ""
      echo "ankh-backup.tar.gpg holds the backup; open it with its own passphrase:"
      echo "  ankh key --import <this directory>"
      echo "or by hand:"
      echo "  gpg --decrypt ankh-backup.tar.gpg | tar -x"
    } >"$dir/README.txt"
  fi
  umask "$old_umask"
  dir="$(cd "$dir" && pwd)"
  _say "backup written to $dir: keep it offline"


  if [[ $full -eq 1 ]]; then
    if [[ $remove -eq 1 ]] || _confirm "Remove the primary key from this machine? It stays in the backup."; then
      local grip
      grip="$(_primary_grip "$fpr")"
      gpg-connect-agent "DELETE_KEY --force $grip" /bye >/dev/null 2>&1 || true
      if _primary_here "$fpr"; then
        _die "the primary key could not be removed"
      fi
      _say "the primary key is gone from this machine; the subkeys stay"
    fi
  fi
  printf 'backup %s\n' "$dir"
}

_tty() {
  # Runs a command that may prompt, on the terminal unless -y.
  if [[ $ANKH_YES -eq 1 ]]; then "$@" </dev/null; else "$@" </dev/tty; fi
}

_confirm_yes() {
  # _confirm_yes <question>: yes unless declined; with -y, always yes.
  [[ $ANKH_YES -eq 1 ]] && return 0
  local ans
  IFS= read -rp "$1 [Y/n] " ans </dev/tty
  [[ -z "$ans" || "$ans" == y || "$ans" == Y || "$ans" == yes ]]
}

# --- pass ------------------------------------------------------------------

_enc_ids() {
  # The long IDs of this machine's usable encryption subkeys (not stubs).
  gpg --with-colons --fixed-list-mode --list-secret-keys 2>/dev/null |
    awk -F: '/^ssb/ && $12 ~ /e/ && $15 != "#" && $2 != "r" && $2 != "e" {print toupper($5)}'
}

_store_recipients_ok() {
  # True when a sample entry is encrypted to a subkey this machine has, or
  # when the store has no entries yet. Reads headers only, decrypts nothing.
  local sample
  sample="$(find "$ANKH_STORE" -path "$ANKH_STORE/.git" -prune -o -type f -name '*.gpg' -print -quit)"
  [[ -n "$sample" ]] || return 0
  local -a to mine
  mapfile -t to < <(gpg --batch --list-only --status-fd 1 --decrypt "$sample" 2>/dev/null |
    awk '$1=="[GNUPG:]" && $2=="ENC_TO"{print toupper($3)}')
  mapfile -t mine < <(_enc_ids)
  local a b
  for a in "${to[@]}"; do
    for b in "${mine[@]}"; do
      [[ "$a" == "$b" ]] && return 0
    done
  done
  return 1
}

_store_git_identity() {
  # pass commits every change; on a fresh machine git may not know who you
  # are yet. Then the store gets a local identity from the key's user ID.
  local fpr="$1"
  git -C "$ANKH_STORE" config user.email >/dev/null 2>&1 && return 0
  local uid name email
  uid="$(_secret_keys | awk -F'\t' -v f="$fpr" '$1==f{print $2; exit}')"
  name="${uid%% <*}"
  email="${uid##*<}"
  email="${email%>}"
  [[ -n "$email" && "$email" != "$uid" ]] || return 0
  git -C "$ANKH_STORE" config user.name "$name"
  git -C "$ANKH_STORE" config user.email "$email"
  _say "git has no identity here: the store commits as $name <$email>"
}

_pass_test_decrypt() {
  # Decrypts one entry to nowhere: proves the key works, shows nothing.
  local sample
  sample="$(find "$ANKH_STORE" -path "$ANKH_STORE/.git" -prune -o -type f -name '*.gpg' -print -quit)"
  [[ -n "$sample" ]] || return 0
  _say "test decrypt of one entry (gpg-agent may ask for the passphrase); the value is discarded"
  gpg --quiet --batch --decrypt "$sample" >/dev/null 2>&1
}

cmd_pass() {
  local source="${pass_source:-}" remote="${pass_remote:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --clone)
      source=clone
      remote="${2:-}"
      [[ -n "$remote" ]] || _die "--clone needs the store's git URL"
      shift
      ;;
    --new) source=new ;;
    --remote)
      remote="${2:-}"
      [[ -n "$remote" ]] || _die "--remote needs a git URL"
      shift
      ;;
    --key)
      gpg_fpr="${2:-}"
      shift
      ;;
    *) _die "pass: unknown option '$1'" ;;
    esac
    shift
  done
  local fpr
  _pick_key fpr

  if [[ -f "$ANKH_STORE/.gpg-id" ]]; then
    if _store_recipients_ok; then
      _say "the store at $ANKH_STORE is already here, encrypted to this key"
      _pass_test_decrypt || _die "the test decrypt failed"
      printf 'pass %s\n' "$ANKH_STORE"
      return 0
    fi
    _die "the store at $ANKH_STORE is encrypted to another key; re-encrypt it there with: pass init $fpr"
  fi
  if [[ -e "$ANKH_STORE" && -n "$(ls -A "$ANKH_STORE" 2>/dev/null)" ]]; then
    _die "$ANKH_STORE exists but isn't a pass store"
  fi

  if [[ -z "$source" ]]; then
    [[ $ANKH_YES -eq 1 ]] && _die "set \$pass_source (clone or new) with -y"
    local ans
    IFS= read -rp "No store at $ANKH_STORE: [c]lone one or start a [n]ew one? " ans </dev/tty
    case "$ans" in
    c | clone)
      source=clone
      prompt remote "The store's git URL" ""
      ;;
    n | new) source=new ;;
    *) _die "invalid choice" ;;
    esac
  fi

  case "$source" in
  clone)
    [[ -n "$remote" ]] || _die "set \$pass_remote to the store's git URL"
    _say "cloning $remote into $ANKH_STORE"
    git clone -q "$remote" "$ANKH_STORE" || _die "clone failed"
    _store_git_identity "$fpr"
    _store_recipients_ok || _die "the cloned store is encrypted to keys this machine doesn't have"
    _pass_test_decrypt || _die "the test decrypt failed"
    ;;
  new)
    PASSWORD_STORE_DIR="$ANKH_STORE" pass init "$fpr" >/dev/null
    git -C "$ANKH_STORE" init -q
    _store_git_identity "$fpr"
    PASSWORD_STORE_DIR="$ANKH_STORE" pass git init >/dev/null
    if [[ -z "$remote" && $ANKH_YES -eq 0 ]]; then
      IFS= read -rp "Git remote for the store (empty for none): " remote </dev/tty
    fi
    if [[ -n "$remote" ]]; then
      git -C "$ANKH_STORE" remote add origin "$remote"
      _say "remote origin is $remote; push with: pass git push -u origin HEAD"
    fi
    _say "new store at $ANKH_STORE, encrypted to $fpr"
    ;;
  *) _die "unknown pass source '$source'" ;;
  esac
  printf 'pass %s\n' "$ANKH_STORE"
}

# --- ssh -------------------------------------------------------------------

_ssh_place() {
  # _ssh_place <default name> [default dir] [name var] [dir var]: asks where
  # the key goes; with -y the answers come from the named variables (ssh_name
  # and ssh_dir unless given). Asks again if the place is taken. Sets SSH_PATH.
  local default_name="$1" default_dir="${2:-$HOME/.ssh}"
  local _sp_nv="${3:-ssh_name}" _sp_dv="${4:-ssh_dir}"
  local _sp_name _sp_dir
  while true; do
    _sp_name="${!_sp_nv:-}" _sp_dir="${!_sp_dv:-}"
    prompt _sp_name "Key name" "$default_name"
    prompt _sp_dir "Directory" "$default_dir"
    [[ "$_sp_name" != */* ]] || _die "a key name can't contain /"
    SSH_PATH="$_sp_dir/$_sp_name"
    [[ -e "$SSH_PATH" || -e "$SSH_PATH.pub" ]] || break
    [[ $ANKH_YES -eq 1 ]] && _die "$SSH_PATH exists already; choose another name"
    _say "$SSH_PATH exists already; choose another name"
  done
  mkdir -p "$_sp_dir"
  chmod 700 "$_sp_dir"
}

_ssh_to_pass() {
  # Backs a key up into pass as ssh/<name>/key, as greb did.
  local path="$1" name
  name="$(basename "$path")"
  if [[ ! -f "$ANKH_STORE/.gpg-id" ]]; then
    _say "no pass store yet: $name isn't backed up into pass (ankh pass, then ankh ssh again)"
    return 0
  fi
  _confirm_yes "Back $name up into pass as ssh/$name/key?" || return 0
  PASSWORD_STORE_DIR="$ANKH_STORE" pass insert -m -f "ssh/$name/key" <"$path" >/dev/null ||
    _die "writing ssh/$name/key into pass failed"
  _say "backed up into pass: ssh/$name/key"
}

_ssh_to_agent() {
  local path="$1"
  [[ $ANKH_YES -eq 1 ]] && return 0
  [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] || return 0
  _confirm_yes "Add it to the SSH agent now?" && ssh-add "$path"
  return 0
}

_ssh_gpg() {
  # SSH through gpg-agent: an authentication subkey offered via sshcontrol.
  local fpr
  _pick_key fpr
  local -a subs
  mapfile -t subs < <(gpg --with-colons --fixed-list-mode --with-keygrip --list-secret-keys "$fpr" 2>/dev/null |
    awk -F: '/^ssb/{a = ($12 ~ /a/ && $15 != "#" && $2 != "r" && $2 != "e"); id = $5; next}
             /^grp/ && a {print id "\t" $10; a = 0}')
  [[ ${#subs[@]} -gt 0 ]] || _die "$fpr has no usable authentication subkey"
  local pick="${subs[0]}"
  if [[ ${#subs[@]} -gt 1 ]]; then
    if [[ -n "${ssh_subkey:-}" ]]; then
      local s
      pick=""
      for s in "${subs[@]}"; do
        [[ "${s%%$'\t'*}" == "${ssh_subkey^^}" ]] && pick="$s"
      done
      [[ -n "$pick" ]] || _die "no authentication subkey ${ssh_subkey}"
    elif [[ $ANKH_YES -eq 1 ]]; then
      _die "several authentication subkeys: set \$ssh_subkey to one"
    else
      local i choice
      for ((i = 0; i < ${#subs[@]}; i++)); do
        printf '  %d) %s (keygrip %s)\n' "$((i + 1))" "${subs[$i]%%$'\t'*}" "${subs[$i]#*$'\t'}" >&2
      done
      IFS= read -rp "Authentication subkey [1-${#subs[@]}]: " choice </dev/tty
      if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#subs[@]})); then
        _die "invalid choice"
      fi
      pick="${subs[$((choice - 1))]}"
    fi
  fi
  local id="${pick%%$'\t'*}" grip="${pick#*$'\t'}"

  local conf="$ANKH_GNUPGHOME/gpg-agent.conf" control="$ANKH_GNUPGHOME/sshcontrol"
  if ! grep -qE '^[[:space:]]*enable-ssh-support' "$conf" 2>/dev/null; then
    _confirm_yes "Turn on SSH support in $conf?" || _die "SSH through gpg-agent needs enable-ssh-support"
    echo "enable-ssh-support" >>"$conf"
    gpgconf --kill gpg-agent
    gpg-connect-agent /bye >/dev/null 2>&1
  fi
  if ! grep -qE "^[[:space:]]*$grip([[:space:]]|$)" "$control" 2>/dev/null; then
    echo "$grip" >>"$control"
    chmod 600 "$control"
  fi
  _say "gpg-agent offers authentication subkey $id to SSH"
  local sock
  sock="$(gpgconf --list-dirs agent-ssh-socket)"
  if [[ "${SSH_AUTH_SOCK:-}" -ef "$sock" ]]; then
    _say "SSH_AUTH_SOCK already points to gpg-agent"
  else
    _say "point SSH at gpg-agent; add to your shell config:"
    # shellcheck disable=SC2016 # printed for the user's shell, unexpanded
    printf '  export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"\n' >&2
  fi
  _say "the public key, for authorized_keys and your git hosts:"
  gpg --export-ssh-key "$id!"
  printf 'ssh gpg:%s\n' "$id"
}

cmd_ssh() {
  local source="${ssh_source:-}" file="${ssh_file:-}" nopass="${ssh_no_passphrase:-0}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --generate) source=generate ;;
    --fido2) source=fido2 ;;
    --existing)
      source=existing
      file="${2:-}"
      [[ -n "$file" ]] || _die "--existing needs the private key file"
      shift
      ;;
    --gpg) source=gpg ;;
    --no-passphrase) nopass=1 ;;
    *) _die "ssh: unknown option '$1'" ;;
    esac
    shift
  done
  if [[ -z "$source" ]]; then
    [[ $ANKH_YES -eq 1 ]] && _die "set \$ssh_source (generate, existing, gpg or fido2) with -y"
    local ans
    printf '  g) generate an ed25519 key\n  e) an existing key file (from a backup, a stick)\n' >&2
    printf '  p) SSH through gpg-agent, with the gpg key'\''s authentication subkey\n' >&2
    printf '  f) a FIDO2 key (ed25519-sk) on a security key\n' >&2
    IFS= read -rp "SSH key: " ans </dev/tty
    case "$ans" in
    g) source=generate ;;
    e)
      source=existing
      prompt file "Private key file" ""
      ;;
    p) source=gpg ;;
    f) source=fido2 ;;
    *) _die "invalid choice" ;;
    esac
  fi

  case "$source" in
  generate | fido2)
    local type=ed25519 default=id_ed25519
    [[ "$source" == fido2 ]] && type=ed25519-sk default=id_ed25519_sk
    _ssh_place "$default"
    local -a opts=(-t "$type" -f "$SSH_PATH" -C "$(id -un)@$(hostname 2>/dev/null || uname -n)")
    if [[ "$nopass" -eq 1 ]]; then
      _say "warning: no passphrase: anyone who copies $SSH_PATH can use it"
      opts+=(-N '')
    fi
    [[ "$source" == fido2 ]] && _say "touch the security key when it blinks"
    _tty ssh-keygen -q "${opts[@]}" || _die "ssh-keygen failed"
    ;;
  existing)
    [[ -f "$file" ]] || _die "$file: no such file"
    _ssh_place "$(basename "$file")"
    cp "$file" "$SSH_PATH"
    chmod 600 "$SSH_PATH"
    if [[ -f "$file.pub" ]]; then
      cp "$file.pub" "$SSH_PATH.pub"
    else
      _say "no $file.pub: deriving the public key (ssh-keygen may ask for the passphrase)"
      _tty ssh-keygen -y -f "$SSH_PATH" >"$SSH_PATH.pub" || _die "could not derive the public key"
    fi
    ;;
  gpg)
    _ssh_gpg
    return 0
    ;;
  *) _die "unknown ssh source '$source'" ;;
  esac
  chmod 644 "$SSH_PATH.pub"
  _ssh_to_pass "$SSH_PATH"
  _ssh_to_agent "$SSH_PATH"
  _say "the public key, for authorized_keys and your git hosts:"
  cat "$SSH_PATH.pub"
  printf 'ssh %s\n' "$SSH_PATH"
}

# --- moving between machines -----------------------------------------------
# A bundle is a directory: a manifest, the key (subkeys.asc, or secret.asc with
# --with-primary), public.asc, ownertrust.txt, ssh/ (key pairs laid out as in
# ~/.ssh) and the store (a git bundle, or a tar when it isn't a repository).
# pull and send move it over SSH; send --paste seals it with a one-time
# passphrase instead, for copy and paste.

ANKH_SSH="${ANKH_SSH:-ssh}"
declare -a SSH_OPTS=()
declare -a ANKH_REMOTE_TMP=()
declare -a MOVE_PARTS=()
MOVE_HOST="" MOVE_FULL=0 MOVE_REMOTE_ANKH="ankh" MOVE_PASTE=0 MOVE_QR=0

_move_args() {
  # Parses [host] [key] [pass] [ssh] and the options pull and send share.
  MOVE_PARTS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    key | pass | ssh) MOVE_PARTS+=("$1") ;;
    --with-primary) MOVE_FULL=1 ;;
    --key)
      gpg_fpr="${2:-}"
      [[ -n "$gpg_fpr" ]] || _die "--key needs a fingerprint"
      shift
      ;;
    --remote-ankh)
      MOVE_REMOTE_ANKH="${2:-}"
      [[ -n "$MOVE_REMOTE_ANKH" ]] || _die "--remote-ankh needs a command"
      shift
      ;;
    --paste) MOVE_PASTE=1 ;;
    --qr) MOVE_QR=1 ;;
    -*) _die "unknown option '$1'" ;;
    *)
      [[ -z "$MOVE_HOST" ]] || _die "one host only (got $MOVE_HOST and $1)"
      MOVE_HOST="$1"
      ;;
    esac
    shift
  done
  if [[ ${#MOVE_PARTS[@]} -eq 0 ]]; then
    if [[ $MOVE_PASTE -eq 1 ]]; then MOVE_PARTS=(key ssh); else MOVE_PARTS=(key pass ssh); fi
  fi
}

_has_part() {
  local p
  for p in "${MOVE_PARTS[@]}"; do [[ "$p" == "$1" ]] && return 0; done
  return 1
}

_bundle_write() {
  # _bundle_write <dir>: the parts in MOVE_PARTS, from this machine.
  local dir="$1" fpr=""
  if _has_part key || _has_part pass; then _pick_key fpr; fi
  mkdir -p "$dir"
  chmod 700 "$dir"
  local old_umask
  old_umask="$(umask)"
  umask 077
  {
    echo "ankh-bundle 1"
    echo "fpr $fpr"
    echo "parts ${MOVE_PARTS[*]}"
  } >"$dir/manifest"
  if _has_part key; then
    _say "exporting $fpr; gpg-agent may ask for the passphrase"
    gpg --armor --export "$fpr" >"$dir/public.asc"
    if [[ $MOVE_FULL -eq 1 ]]; then
      _primary_here "$fpr" || _die "--with-primary: the primary key isn't on this machine"
      gpg --armor --export-secret-keys "$fpr" >"$dir/secret.asc" || _die "export failed"
    else
      gpg --armor --export-secret-subkeys "$fpr" >"$dir/subkeys.asc" || _die "export failed"
    fi
    gpg --export-ownertrust 2>/dev/null | grep "^$fpr:" >"$dir/ownertrust.txt" ||
      printf '%s:6:\n' "$fpr" >"$dir/ownertrust.txt"
  fi
  if _has_part pass; then
    [[ -f "$ANKH_STORE/.gpg-id" ]] || _die "no pass store at $ANKH_STORE"
    if git -C "$ANKH_STORE" rev-parse --git-dir >/dev/null 2>&1; then
      if [[ -n "$(git -C "$ANKH_STORE" status --porcelain 2>/dev/null)" ]]; then
        _say "warning: the store has uncommitted changes; they aren't moved"
      fi
      git -C "$ANKH_STORE" bundle create "$dir/store.bundle" --all 2>/dev/null ||
        _die "could not bundle the store"
      git -C "$ANKH_STORE" remote get-url origin >"$dir/store-remote.txt" 2>/dev/null || true
    else
      tar -C "$ANKH_STORE" -cf "$dir/store.tar" .
    fi
  fi
  if _has_part ssh; then
    local n
    n="$(_backup_ssh "$dir")"
    _say "$n SSH key pair(s) in the bundle"
  fi
  umask "$old_umask"
}

_bundle_store() {
  # The store part of a bundle, into ANKH_STORE.
  local dir="$1" fpr="$2"
  if [[ -f "$ANKH_STORE/.gpg-id" ]]; then
    _store_recipients_ok || _die "a store for another key is at $ANKH_STORE already"
    _say "a store is here already: the bundle's store is skipped"
    return 0
  fi
  if [[ -e "$ANKH_STORE" && -n "$(ls -A "$ANKH_STORE" 2>/dev/null)" ]]; then
    _die "$ANKH_STORE exists but isn't a pass store"
  fi
  if [[ -f "$dir/store.bundle" ]]; then
    git clone -q "$dir/store.bundle" "$ANKH_STORE" 2>/dev/null || _die "could not clone the store from the bundle"
    local url=""
    [[ -f "$dir/store-remote.txt" ]] && url="$(head -n 1 "$dir/store-remote.txt")"
    if [[ -n "$url" ]]; then
      git -C "$ANKH_STORE" remote set-url origin "$url"
      _say "the store's remote is $url, as on the old machine"
    else
      git -C "$ANKH_STORE" remote remove origin
    fi
  elif [[ -f "$dir/store.tar" ]]; then
    mkdir -p "$ANKH_STORE"
    chmod 700 "$ANKH_STORE"
    tar -C "$ANKH_STORE" -xf "$dir/store.tar"
  else
    _die "the bundle has no store"
  fi
  if [[ -n "$fpr" ]] && git -C "$ANKH_STORE" rev-parse --git-dir >/dev/null 2>&1; then
    _store_git_identity "$fpr"
  fi
  _store_recipients_ok || _die "the store is encrypted to keys this machine doesn't have"
  _pass_test_decrypt || _die "the test decrypt failed"
  _say "store at $ANKH_STORE"
}

_bundle_ssh() {
  # Places each key pair, asking its name and directory (defaults: as it was).
  local dir="$1" priv rel name target
  [[ -d "$dir/ssh" ]] || return 0
  while IFS= read -r priv; do
    [[ -f "$priv.pub" ]] || continue
    rel="$(dirname "${priv#"$dir/ssh"}")"
    [[ "$rel" == / || "$rel" == . ]] && rel=""
    name="$(basename "$priv")"
    target="$HOME/.ssh$rel/$name"
    if [[ -f "$target" ]] && cmp -s "$priv" "$target"; then
      _say "$target is here already"
      continue
    fi
    _say "SSH key $name"
    _ssh_place "$name" "$HOME/.ssh$rel" _none_name _none_dir
    cp "$priv" "$SSH_PATH"
    cp "$priv.pub" "$SSH_PATH.pub"
    chmod 600 "$SSH_PATH"
    chmod 644 "$SSH_PATH.pub"
    _say "placed $SSH_PATH"
  done < <(find "$dir/ssh" -type f ! -name '*.pub' | LC_ALL=C sort)
}

_bundle_apply() {
  # _bundle_apply <dir>: the key first, then the store, then SSH.
  local dir="$1" fpr parts
  [[ "$(head -n 1 "$dir/manifest" 2>/dev/null)" == "ankh-bundle 1" ]] || _die "$dir is not an ankh bundle"
  fpr="$(awk '$1=="fpr"{print $2}' "$dir/manifest")"
  parts="$(awk '$1=="parts"{$1=""; print}' "$dir/manifest")"
  local -a MOVE_PARTS
  read -ra MOVE_PARTS <<<"$parts"
  if _has_part key; then
    local file="$dir/subkeys.asc"
    [[ -f "$dir/secret.asc" ]] && file="$dir/secret.asc"
    _key_import "$file"
    [[ "$KEY_FPR" == "$fpr" ]] || _die "the bundle's key is $KEY_FPR, its manifest says $fpr"
    gpg --import-ownertrust "$dir/ownertrust.txt" 2>/dev/null
    _say "key $fpr imported$([[ -f "$dir/secret.asc" ]] && echo ', primary included' || echo ', subkeys only')"
  fi
  if _has_part pass; then _bundle_store "$dir" "$fpr"; fi
  if _has_part ssh; then _bundle_ssh "$dir"; fi
  printf 'received %s\n' "${MOVE_PARTS[*]}"
}

# --- moving: the SSH side --------------------------------------------------

_ssh_master() {
  # One SSH connection for every step, so a password is asked once.
  local t
  _tmpdir t
  SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=$t/cm-%C" -o ControlPersist=120)
}

_rsh() {
  # _rsh [-t] <command...>: runs on MOVE_HOST; -t gives it the terminal.
  local -a tty=()
  if [[ "${1:-}" == -t ]]; then
    shift
    [[ $ANKH_YES -eq 0 ]] && tty=(-t)
  fi
  "$ANKH_SSH" "${SSH_OPTS[@]}" "${tty[@]}" "$MOVE_HOST" "$@"
}

_remote_tmpdir() {
  # _remote_tmpdir <var>: a private directory on MOVE_HOST, removed at exit.
  local _rt_var="$1" _rt_dir
  # shellcheck disable=SC2016 # expanded by the other machine's sh
  local _rt_sh='umask 077; d="${XDG_RUNTIME_DIR:-/tmp}"; [ -d "$d" ] && [ -w "$d" ] || d=/tmp; mktemp -d "$d/ankh-move.XXXXXX"'
  _rt_dir="$(_rsh sh -s <<<"$_rt_sh")" || _die "could not reach $MOVE_HOST"
  [[ "$_rt_dir" =~ ^/[A-Za-z0-9/._-]+$ ]] || _die "unexpected answer from $MOVE_HOST: $_rt_dir"
  ANKH_REMOTE_TMP+=("$MOVE_HOST"$'\t'"$_rt_dir")
  printf -v "$_rt_var" '%s' "$_rt_dir"
}

_remote_cleanup() {
  local e
  for e in "${ANKH_REMOTE_TMP[@]}"; do
    MOVE_HOST="${e%%$'\t'*}"
    _rsh rm -rf "${e#*$'\t'}" </dev/null >/dev/null 2>&1 || true
  done
  ANKH_REMOTE_TMP=()
  if [[ ${#SSH_OPTS[@]} -gt 0 && -n "$MOVE_HOST" ]]; then
    "$ANKH_SSH" "${SSH_OPTS[@]}" -O exit "$MOVE_HOST" >/dev/null 2>&1 || true
  fi
}

_copy() {
  # _copy <from> <to>: one side is host:path. rsync when both ends have it.
  if command -v rsync >/dev/null 2>&1 && _rsh command -v rsync </dev/null >/dev/null 2>&1; then
    rsync -a -e "$ANKH_SSH ${SSH_OPTS[*]}" "$1" "$2"
  else
    scp -q -r -p -S "$ANKH_SSH" "${SSH_OPTS[@]}" "$1" "$2"
  fi
}

_remote_args() {
  # The ankh command line for the other machine.
  REMOTE_ARGS=()
  [[ $ANKH_YES -eq 1 ]] && REMOTE_ARGS+=(-y)
  REMOTE_ARGS+=("$@")
}

cmd_pull() {
  _move_args "$@"
  [[ -n "$MOVE_HOST" ]] || _die "usage: ankh pull <user@host> [key] [pass] [ssh] [--with-primary] [--key <fpr>]"
  [[ $MOVE_PASTE -eq 0 ]] || _die "--paste is for send"
  _ssh_master
  local rdir t
  _remote_tmpdir rdir
  local -a REMOTE_ARGS
  local -a opts=("${MOVE_PARTS[@]}")
  [[ $MOVE_FULL -eq 1 ]] && opts+=(--with-primary)
  [[ -n "${gpg_fpr:-}" ]] && opts+=(--key "$gpg_fpr")
  _remote_args bundle "$rdir/bundle" "${opts[@]}"
  _say "on $MOVE_HOST: writing a bundle of ${MOVE_PARTS[*]} (its gpg-agent may ask for the passphrase)"
  # shellcheck disable=SC2086 # --remote-ankh may be a command with arguments
  _rsh -t $MOVE_REMOTE_ANKH "${REMOTE_ARGS[@]}" || _die "the bundle on $MOVE_HOST failed"
  _tmpdir t
  _copy "$MOVE_HOST:$rdir/bundle" "$t/" || _die "copying the bundle failed"
  _remote_cleanup
  _bundle_apply "$t/bundle"
}

_one_time_passphrase() {
  # 24 characters from a 32-letter alphabet (120 bits), in groups of four.
  local abc="abcdefghijkmnpqrstuvwxyz23456789" out="" b i=0
  for b in $(od -An -N24 -tu1 /dev/urandom); do
    [[ $i -gt 0 && $((i % 4)) -eq 0 ]] && out+="-"
    out+="${abc:$((b % 32)):1}"
    i=$((i + 1))
  done
  printf '%s' "$out"
}

_send_paste() {
  _has_part pass && _die "the store is too big to paste: clone it (ankh pass --clone) or use pull or send"
  local t pw
  _tmpdir t
  _bundle_write "$t/bundle"
  pw="$(_one_time_passphrase)"
  tar -C "$t/bundle" -czf - . |
    gpg --batch --quiet --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3 \
      --armor --symmetric --output "$t/bundle.asc" 3< <(printf '%s\n' "$pw") || _die "sealing failed"
  cat "$t/bundle.asc"
  if [[ $MOVE_QR -eq 1 ]]; then
    command -v qrencode >/dev/null 2>&1 || _die "--qr needs qrencode"
    qrencode -t ANSIUTF8 <"$t/bundle.asc" >&2 || _say "the bundle is too big for one QR code: paste it instead"
  fi
  _say "on the new machine: ankh receive, then paste the block above"
  _say "one-time passphrase (shown once; give it by another channel than the block):"
  printf '\n    %s\n\n' "$pw" >&2
}

cmd_send() {
  _move_args "$@"
  if [[ $MOVE_PASTE -eq 1 ]]; then
    [[ -z "$MOVE_HOST" ]] || _die "--paste takes no host"
    _send_paste
    return 0
  fi
  [[ -n "$MOVE_HOST" ]] || _die "usage: ankh send <user@host> [key] [pass] [ssh] [--with-primary] | ankh send --paste [key] [ssh] [--qr]"
  local t rdir
  _tmpdir t
  _bundle_write "$t/bundle"
  _ssh_master
  _remote_tmpdir rdir
  _copy "$t/bundle" "$MOVE_HOST:$rdir/" || _die "copying the bundle failed"
  local -a REMOTE_ARGS
  _remote_args receive "$rdir/bundle"
  _say "on $MOVE_HOST: receiving ${MOVE_PARTS[*]}"
  # shellcheck disable=SC2086 # --remote-ankh may be a command with arguments
  _rsh -t $MOVE_REMOTE_ANKH "${REMOTE_ARGS[@]}" || _die "receiving on $MOVE_HOST failed"
  _remote_cleanup
  printf 'sent %s to %s\n' "${MOVE_PARTS[*]}" "$MOVE_HOST"
}

cmd_bundle() {
  local dir=""
  local -a rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    key | pass | ssh | --with-primary) rest+=("$1") ;;
    --key)
      rest+=("$1" "${2:-}")
      shift
      ;;
    -*) _die "bundle: unknown option '$1'" ;;
    *)
      [[ -z "$dir" ]] || _die "bundle: one directory only"
      dir="$1"
      ;;
    esac
    shift
  done
  [[ -n "$dir" ]] || _die "usage: ankh bundle <dir> [key] [pass] [ssh] [--with-primary] [--key <fpr>]"
  if [[ -e "$dir" ]]; then
    [[ -d "$dir" && -z "$(ls -A "$dir")" ]] || _die "$dir exists and isn't an empty directory"
  fi
  _move_args "${rest[@]}"
  _bundle_write "$dir"
  printf 'bundle %s\n' "$dir"
}

cmd_receive() {
  local src="${1:-}"
  [[ $# -le 1 ]] || _die "usage: ankh receive [<bundle dir> | <pasted file>]"
  if [[ -n "$src" && -d "$src" ]]; then
    _bundle_apply "$src"
    return 0
  fi
  local t
  _tmpdir t
  if [[ -n "$src" ]]; then
    [[ -f "$src" ]] || _die "$src: no such file or directory"
    cp "$src" "$t/bundle.asc"
  else
    [[ -t 0 ]] && _say "paste the block from ankh send --paste, then Ctrl+D:"
    cat >"$t/bundle.asc"
  fi
  grep -q -- '-----BEGIN PGP MESSAGE-----' "$t/bundle.asc" || _die "that isn't a block from ankh send --paste"
  mkdir -m 700 "$t/bundle"
  _say "opening it: gpg-agent asks for the one-time passphrase"
  gpg --quiet --no-symkey-cache --decrypt "$t/bundle.asc" 2>/dev/null </dev/null | tar -xz -C "$t/bundle" ||
    _die "could not open the block (a wrong passphrase, or a damaged paste)"
  _bundle_apply "$t/bundle"
}

# --- verify ------------------------------------------------------------------
# A checkpoint is a URL or a file in sha256sum format. A mismatch stops; one
# that can't be reached, or doesn't list the file, is a warning; none that
# confirms it stops, unless --insecure-skip-verify.

_default_checkpoints() {
  local tag="$1"
  printf '%s\n' \
    "https://codeberg.org/lede/ankh/releases/download/$tag/SHA256SUMS" \
    "https://github.com/lede/ankh/releases/download/$tag/SHA256SUMS" \
    "https://gitlab.com/lede/ankh/-/releases/$tag/downloads/SHA256SUMS"
}

_fetch_checkpoint() {
  case "$1" in
  *://*)
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --max-time 20 --max-filesize 1048576 "$1" 2>/dev/null
    elif command -v wget >/dev/null 2>&1; then
      wget -q -T 20 -O - "$1" 2>/dev/null
    else
      return 1
    fi
    ;;
  *) [[ -f "$1" && -r "$1" ]] && cat "$1" ;;
  esac
}

_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

cmd_verify() {
  local file="" name="" defaults=1 skip=0
  local -a cps=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --checkpoint)
      [[ -n "${2:-}" ]] || _die "--checkpoint needs a URL or a file"
      cps+=("$2")
      shift
      ;;
    --as)
      name="${2:-}"
      shift
      ;;
    --no-default-checkpoints) defaults=0 ;;
    --insecure-skip-verify) skip=1 ;;
    -*) _die "verify: unknown option '$1'" ;;
    *)
      [[ -z "$file" ]] || _die "verify: one file only"
      file="$1"
      ;;
    esac
    shift
  done
  [[ -n "$file" ]] || _die "usage: ankh verify <file> [--checkpoint <url|file>]... [--no-default-checkpoints] [--as <name>]"
  [[ -f "$file" ]] || _die "$file: no such file"
  [[ -n "$name" ]] || name="$(basename "$file")"
  if [[ $defaults -eq 1 ]]; then
    local ver
    ver="$(sed -n 's/^ANKH_VERSION="\([0-9A-Za-z.+-]*\)"$/\1/p' "$file" | head -n 1)"
    if [[ -n "$ver" ]]; then
      mapfile -t -O "${#cps[@]}" cps < <(_default_checkpoints "v$ver")
    else
      _say "warning: no version found in $file: the default checkpoints aren't used"
    fi
  fi
  [[ ${#cps[@]} -gt 0 ]] || _die "no checkpoints: give one with --checkpoint"
  local sum cp body listed confirmed=0
  sum="$(_sha256 "$file")"
  _say "$name: sha256 $sum"
  for cp in "${cps[@]}"; do
    if ! body="$(_fetch_checkpoint "$cp")"; then
      _say "warning: unreachable: $cp"
      continue
    fi
    listed="$(awk -v n="$name" '$2 == n || $2 == "*" n {print tolower($1)}' <<<"$body")"
    if [[ -z "$listed" ]]; then
      _say "warning: $cp doesn't list $name"
    elif [[ "$(sort -u <<<"$listed")" == "$sum" ]]; then
      _say "ok: $cp"
      confirmed=$((confirmed + 1))
    else
      _die "MISMATCH: $cp lists another checksum for $name. Do not run it."
    fi
  done
  if [[ $confirmed -eq 0 ]]; then
    [[ $skip -eq 1 ]] || _die "no checkpoint confirmed $name: not verified"
    _say "warning: NOT verified (--insecure-skip-verify)"
    printf 'unverified %s\n' "$file"
    return 0
  fi
  printf 'verified %s (%d checkpoint(s))\n' "$file" "$confirmed"
}

# --- init --------------------------------------------------------------------

cmd_init() {
  [[ $# -eq 0 ]] || _die "init takes no options; use the environment with -y"
  _say "where things stand now:"
  cmd_check || true
  echo ""
  _say "1/3 the gpg key"
  cmd_key
  gpg_fpr="$KEY_FPR"
  [[ -n "$gpg_fpr" ]] || _die "no key chosen"
  echo ""
  _say "2/3 the pass store"
  cmd_pass
  echo ""
  _say "3/3 SSH"
  cmd_ssh
  echo ""
  _say "where things stand now:"
  cmd_check
}

main() {
  while [[ "${1:-}" == -y || "${1:-}" == --yes ]]; do
    ANKH_YES=1
    shift
  done
  case "${1:-}" in
  check)
    shift
    cmd_check "$@"
    ;;
  key)
    shift
    cmd_key "$@"
    ;;
  backup)
    shift
    cmd_backup "$@"
    ;;
  pass)
    shift
    cmd_pass "$@"
    ;;
  ssh)
    shift
    cmd_ssh "$@"
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  pull)
    shift
    cmd_pull "$@"
    ;;
  send)
    shift
    cmd_send "$@"
    ;;
  receive)
    shift
    cmd_receive "$@"
    ;;
  bundle)
    shift
    cmd_bundle "$@"
    ;;
  verify)
    shift
    cmd_verify "$@"
    ;;
  version | --version)
    printf 'ankh %s\n' "$ANKH_VERSION"
    ;;
  "")
    banner
    usage
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
