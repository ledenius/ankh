# ankh: identity bootstrap for a fresh machine. Gets a gpg key, a pass store
# that decrypts and SSH working, then stops.
if [[ "${BASH_VERSINFO[0]}" -lt 5 ]]; then
  echo "ankh: bash 5+ required (have ${BASH_VERSION})" >&2
  exit 1
fi
set -euo pipefail

ANKH_VERSION="0.1.0-dev"

# Drop ankh's own directory from PATH so the commands it runs (gpg, pass, ...)
# never resolve to sibling files installed next to the script itself.
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$_dir" | paste -sd ':' || true)"
if [[ -n "$_path" ]]; then PATH="$_path"; fi
unset _path _dir

ANKH_STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
ANKH_GNUPGHOME="${GNUPGHOME:-$HOME/.gnupg}"
# SSH keys default to ~/.ssh; ~/.ssh/keys is where greb put them.
ANKH_SSH_DIRS=("$HOME/.ssh" "$HOME/.ssh/keys")

banner() {
  cat <<'BANNER'
