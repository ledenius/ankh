# bash completion for ankh
# shellcheck shell=bash
_ankh() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  if [[ $COMP_CWORD -eq 1 ]]; then
    mapfile -t COMPREPLY < <(compgen -W "check version help" -- "$cur")
    return
  fi
  case "${COMP_WORDS[1]}" in
  check) mapfile -t COMPREPLY < <(compgen -W "--decrypt" -- "$cur") ;;
  esac
}
complete -F _ankh ankh
