# bash completion for ankh
# shellcheck shell=bash
_ankh() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD - 1]}"
  local i cmd=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    case "${COMP_WORDS[i]}" in
    -y | --yes) ;;
    *)
      cmd="${COMP_WORDS[i]}"
      break
      ;;
    esac
  done
  if [[ -z "$cmd" ]]; then
    mapfile -t COMPREPLY < <(compgen -W "-y init check key backup pass ssh pull send receive bundle verify version help" -- "$cur")
    return
  fi
  case "$cmd" in
  check) mapfile -t COMPREPLY < <(compgen -W "--decrypt" -- "$cur") ;;
  key)
    if [[ "$prev" == --import ]]; then
      mapfile -t COMPREPLY < <(compgen -f -- "$cur")
    else
      mapfile -t COMPREPLY < <(compgen -W "--existing --generate --import" -- "$cur")
    fi
    ;;
  pass)
    case "$prev" in
    --clone | --remote | --key) ;;
    *) mapfile -t COMPREPLY < <(compgen -W "--clone --new --remote --key" -- "$cur") ;;
    esac
    ;;
  ssh)
    if [[ "$prev" == --existing ]]; then
      mapfile -t COMPREPLY < <(compgen -f -- "$cur")
    else
      mapfile -t COMPREPLY < <(compgen -W "--generate --existing --gpg --fido2 --no-passphrase" -- "$cur")
    fi
    ;;
  pull | send | bundle)
    case "$prev" in
    --key | --remote-ankh) ;;
    *) mapfile -t COMPREPLY < <(compgen -W "key pass ssh --with-primary --key --remote-ankh --paste --qr" -- "$cur") ;;
    esac
    ;;
  receive) mapfile -t COMPREPLY < <(compgen -f -- "$cur") ;;
  verify)
    case "$prev" in
    --checkpoint) mapfile -t COMPREPLY < <(compgen -f -- "$cur") ;;
    --as) ;;
    *)
      if [[ "$cur" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--checkpoint --no-default-checkpoints --as --insecure-skip-verify" -- "$cur")
      else
        mapfile -t COMPREPLY < <(compgen -f -- "$cur")
      fi
      ;;
    esac
    ;;
  backup)
    case "$prev" in
    --key) ;;
    *)
      if [[ "$cur" == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "--key --encrypt --remove-primary" -- "$cur")
      else
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
      fi
      ;;
    esac
    ;;
  esac
}
complete -F _ankh ankh
