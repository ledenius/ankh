#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# ankh-verify: check a downloaded ankh before running it. Short on purpose:
# read it first. A checkpoint is a URL or a file in sha256sum format; the
# defaults are the release's SHA256SUMS on the public mirrors. A mismatch
# stops; a checkpoint that can't be reached (or doesn't list the file) warns;
# none confirming stops, unless --insecure-skip-verify.
# Usage: ankh-verify [<file>] [--checkpoint <url|file>]... [--no-default-checkpoints]
#                    [--as <name>] [--insecure-skip-verify]
set -euo pipefail
say() { echo "ankh-verify: $*" >&2; }
file="" name="" defaults=1 skip=0 confirmed=0 cps=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --checkpoint) cps+=("${2:?--checkpoint needs a URL or a file}") && shift ;;
  --as) name="${2:?--as needs a name}" && shift ;;
  --no-default-checkpoints) defaults=0 ;;
  --insecure-skip-verify) skip=1 ;;
  -*) say "unknown option $1" && exit 2 ;;
  *) file="$1" ;;
  esac
  shift
done
file="${file:-$(dirname "$0")/ankh}" && name="${name:-$(basename "$file")}"
[[ -f "$file" ]] || { say "$file: no such file"; exit 2; }
tag="v$(sed -n 's/^ANKH_VERSION="\([0-9A-Za-z.+-]*\)"$/\1/p' "$file" | head -n 1)"
if [[ $defaults -eq 1 && "$tag" != v ]]; then
  cps+=("https://codeberg.org/lede/ankh/releases/download/$tag/SHA256SUMS"
    "https://github.com/ledenius/ankh/releases/download/$tag/SHA256SUMS"
    "https://gitlab.com/lede/ankh/-/releases/$tag/downloads/SHA256SUMS")
fi
fetch() {
  case "$1" in
  *://*) if command -v curl >/dev/null; then curl -fsSL --max-time 20 --max-filesize 1048576 "$1"
    else wget -q -T 20 -O - "$1"; fi 2>/dev/null ;;
  *) cat "$1" 2>/dev/null ;;
  esac
}
if command -v sha256sum >/dev/null; then sum="$(sha256sum "$file")"; else sum="$(shasum -a 256 "$file")"; fi
sum="${sum%% *}" && say "$name: sha256 $sum"
for cp in "${cps[@]}"; do
  body="$(fetch "$cp")" || { say "warning: unreachable: $cp"; continue; }
  listed="$(awk -v n="$name" '$2 == n || $2 == "*" n {print tolower($1)}' <<<"$body" | sort -u)"
  if [[ -z "$listed" ]]; then say "warning: $cp doesn't list $name"
  elif [[ "$listed" == "$sum" ]]; then say "ok: $cp" && confirmed=$((confirmed + 1))
  else say "MISMATCH: $cp lists another checksum for $name. Do not run it." && exit 1; fi
done
if [[ $confirmed -eq 0 && $skip -eq 0 ]]; then say "no checkpoint confirmed $name: not verified" && exit 1; fi
[[ $confirmed -eq 0 ]] && say "warning: NOT verified (--insecure-skip-verify)" && exit 0
echo "verified $file ($confirmed checkpoint(s))"
